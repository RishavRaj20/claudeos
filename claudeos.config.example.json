{
  "port": 7777,
  "defaultProvider": "claude",
  "providers": {
    "claude": {
      "type": "claude",
      "model": "claude-opus-5"
    },
    "ollama": {
      "type": "ollama",
      "model": "llama3.2",
      "baseUrl": "http://localhost:11434"
    },
    "claude-code": {
      "type": "cli",
      "command": "claude",
      "args": ["-p", "{prompt}"],
      "timeoutMs": 600000
    },
    "gemini": {
      "type": "cli",
      "command": "gemini",
      "args": ["-p", "{prompt}"],
      "timeoutMs": 600000
    },
    "codex": {
      "type": "cli",
      "command": "codex",
      "args": ["exec", "{prompt}"],
      "timeoutMs": 600000
    }
  },
  "memory": {
    "inject": true,
    "maxEntries": 3,
    "maxCharsPerEntry": 600
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allowed/directory"]
    }
  },
  "routing": [
    { "match": "\\b(code|refactor|implement|debug|fix bug|write a script|repo)\\b", "provider": "claude-code" },
    { "match": "\\b(summarize|summarise|translate|classify|extract)\\b", "provider": "ollama" }
  ]
}
